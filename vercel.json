{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "app": {
            "root": ".",
            "framework": "nextjs"
        },
        "ai-engine": {
            "root": "ai-engine",
            "runtime": "python"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": {
                "service": "app"
            }
        }
    ]
}